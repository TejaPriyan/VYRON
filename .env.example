# VYRON environment. Copy to .env and fill in. Never commit .env.
# Values below marked "local dev only" are for docker-compose on your own machine, never for production.

# --- runtime ---
# APP_ENV: development | test | production. Production is stricter (stable secrets required).
APP_ENV=development
LOG_LEVEL=info
# DATA_MODE: seed (in-memory development seed) | database (PostgreSQL + Neo4j + Redis).
# Default is seed in development and database in production. The database adapters are not
# implemented yet, so only seed mode runs today. Production refuses seed unless ALLOW_SEED_DATA=true.
DATA_MODE=seed
ALLOW_SEED_DATA=false
# Number of trusted reverse proxies in front of the API (0 = ignore X-Forwarded-For).
TRUSTED_PROXY_HOPS=0

# --- web (public values only; anything NEXT_PUBLIC_* is shipped to browsers) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-side only: where the Next.js server reaches the API
API_INTERNAL_URL=http://localhost:8000

# --- PostgreSQL (authoritative store) ---
POSTGRES_USER=vyron
POSTGRES_PASSWORD=vyron_dev_only            # local dev only
POSTGRES_DB=vyron
DATABASE_URL=postgresql://vyron:vyron_dev_only@localhost:5432/vyron

# --- Neo4j (graph projection) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=vyron_dev_only               # local dev only (Neo4j requires 8+ characters)

# --- Redis (cache, rate limits, job queue) ---
REDIS_URL=redis://localhost:6379/0

# --- GitHub (server-side only; leave empty to run unauthenticated at 60 requests/hour; a token with no scopes is enough for public repositories) ---
GITHUB_TOKEN=

# --- Gemini (server-side only; leave empty to disable AI features, the rest of VYRON keeps working) ---
GEMINI_API_KEY=
# Pick a model id from https://ai.google.dev/gemini-api/docs/models and verify it before use.
GEMINI_MODEL=

# --- sessions ---
# At least 32 characters. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Pagination-cursor signing keys are derived from it. Rotate by moving the old value to
# SESSION_SECRET_PREVIOUS (still accepted) and setting a new SESSION_SECRET.
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=
