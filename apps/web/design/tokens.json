{
  "$schema-note": "Source of truth for VYRON's visual language. scripts/generate_design_tokens.py turns this into CSS custom properties and a typed TypeScript module; tests/test_design_contract.py checks contrast, colour-vision separation and coverage of the API's enums. Edit this file, never the generated outputs.",
  "version": 1,
  "theme": {
    "name": "observatory",
    "colorScheme": "dark",
    "note": "One dark theme by design (the brief asks for a dark, cinematic instrument). There is no light theme; forced-colors and prefers-contrast are handled in CSS, see docs/FRONTEND.md."
  },
  "color": {
    "surface": {
      "ink": "#0a0e14",
      "basalt": "#121821",
      "slate": "#1a222d"
    },
    "line": {
      "hairline": "#252e3b",
      "strong": "#3a4657",
      "control": "#66758a"
    },
    "text": {
      "bone": "#e8e5db",
      "ash": "#aab2bd",
      "dust": "#8a94a1"
    },
    "accent": {
      "signal": "#3fcfe8",
      "signal-hover": "#8be3f3",
      "signal-ink": "#04222a"
    },
    "status": {
      "ok": "#66c29a",
      "warn": "#e0b04a",
      "error": "#f0807a"
    }
  },
  "data": {
    "surface": "ink",
    "note": "Colour encodes four groups because a node-link graph needs every pair of colours to stay distinct; the full eight-hue reference palette fails the all-pairs gates. Shape is the required second encoding and the exact kind is always available as text.",
    "groupOrder": ["software", "intelligence", "organizations", "events"],
    "groups": {
      "software": { "label": "Software and infrastructure", "color": "#9085e9" },
      "intelligence": { "label": "AI and research", "color": "#c98500" },
      "organizations": { "label": "Organizations", "color": "#d55181" },
      "events": { "label": "Events", "color": "#008300" }
    },
    "shapes": ["circle", "square", "diamond", "triangle", "triangle-down", "hexagon", "plus", "star"],
    "kinds": {
      "technology": { "group": "software", "shape": "circle", "label": "Technology" },
      "language": { "group": "software", "shape": "diamond", "label": "Language" },
      "framework": { "group": "software", "shape": "square", "label": "Framework" },
      "library": { "group": "software", "shape": "triangle", "label": "Library" },
      "platform": { "group": "software", "shape": "hexagon", "label": "Platform" },
      "database": { "group": "software", "shape": "triangle-down", "label": "Database" },
      "repository": { "group": "software", "shape": "plus", "label": "Repository" },
      "api": { "group": "software", "shape": "star", "label": "API" },
      "ai_model": { "group": "intelligence", "shape": "hexagon", "label": "AI model" },
      "dataset": { "group": "intelligence", "shape": "square", "label": "Dataset" },
      "research_paper": { "group": "intelligence", "shape": "triangle", "label": "Research paper" },
      "company": { "group": "organizations", "shape": "square", "label": "Company" },
      "organization": { "group": "organizations", "shape": "circle", "label": "Organization" },
      "event": { "group": "events", "shape": "diamond", "label": "Event" }
    }
  },
  "provenance": {
    "note": "Provenance is drawn, not coloured: edge and outline style carry it on the canvas, an icon plus a word carry it in panels. The style class groups labels that a reader should treat alike.",
    "styles": {
      "verified": { "dash": "none", "outline": "solid" },
      "derived": { "dash": "6 3", "outline": "dashed" },
      "conjecture": { "dash": "1 4", "outline": "dotted" },
      "working": { "dash": "8 3 1 3", "outline": "dashdot" }
    },
    "kinds": {
      "sourced": { "label": "Sourced", "style": "verified", "icon": "seal-check" },
      "estimated": { "label": "Estimated", "style": "derived", "icon": "approx" },
      "inferred": { "label": "Inferred", "style": "derived", "icon": "branch" },
      "predicted": { "label": "Predicted", "style": "conjecture", "icon": "forecast" },
      "ai_generated": { "label": "AI-generated", "style": "conjecture", "icon": "spark" },
      "user_generated": { "label": "Your note", "style": "working", "icon": "person" },
      "seed": { "label": "Development seed", "style": "working", "icon": "beaker" }
    }
  },
  "type": {
    "families": {
      "serif": "Newsreader, 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif",
      "sans": "'Hanken Grotesk', 'Segoe UI', system-ui, -apple-system, Roboto, 'Helvetica Neue', Arial, sans-serif",
      "code": "ui-monospace, SFMono-Regular, Menlo, Consolas, 'Liberation Mono', monospace"
    },
    "webFonts": [
      { "family": "Newsreader", "license": "OFL-1.1", "axes": "opsz, wght, ital", "role": "names, headings, reading text" },
      { "family": "Hanken Grotesk", "license": "OFL-1.1", "axes": "wght", "role": "interface" }
    ],
    "roles": {
      "title": { "family": "serif", "size": "2.125rem", "line": 1.1, "weight": 450, "tracking": "-0.01em" },
      "heading": { "family": "serif", "size": "1.375rem", "line": 1.2, "weight": 500, "tracking": "0" },
      "reading": { "family": "serif", "size": "1.0625rem", "line": 1.6, "weight": 400, "tracking": "0", "maxCh": 68 },
      "body": { "family": "sans", "size": "0.9375rem", "line": 1.5, "weight": 400, "tracking": "0" },
      "label": { "family": "sans", "size": "0.8125rem", "line": 1.3, "weight": 500, "tracking": "0.005em" },
      "figure": { "family": "sans", "size": "0.9375rem", "line": 1.3, "weight": 500, "tracking": "0", "features": "tnum" },
      "mapLabel": { "family": "serif", "size": "0.8125rem", "line": 1.1, "weight": 500, "tracking": "0" },
      "code": { "family": "code", "size": "0.8125rem", "line": 1.45, "weight": 400, "tracking": "0" }
    }
  },
  "space": { "0": "0", "1": "2px", "2": "4px", "3": "8px", "4": "12px", "5": "16px", "6": "24px", "7": "32px", "8": "48px", "9": "64px" },
  "radius": { "none": "0", "control": "3px", "mark": "2px" },
  "border": { "hairline": "1px", "focus": "2px", "focusGap": "2px" },
  "target": { "finePointer": "32px", "coarsePointer": "44px", "minimum": "24px" },
  "motion": {
    "duration": { "instant": "0ms", "quick": "90ms", "base": "160ms", "slow": "280ms", "camera": "600ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "enter": "cubic-bezier(0, 0, 0, 1)", "exit": "cubic-bezier(0.3, 0, 1, 1)" },
    "reducedMotion": "All durations become 0ms; camera moves jump; path tracing shows the final state; nothing loops."
  },
  "breakpoint": { "compact": "0", "medium": "768px", "expanded": "1100px", "wide": "1440px" },
  "layer": { "canvas": 0, "chrome": 10, "pane": 20, "sheet": 30, "popover": 40, "dialog": 50, "toast": 60 },
  "layout": {
    "railWidth": "264px",
    "railCollapsedWidth": "56px",
    "dossierWidth": "400px",
    "topBarHeight": "48px",
    "timelineHeight": "88px",
    "readingMeasure": "68ch"
  },
  "budget": {
    "note": "Targets to measure against once the app runs. Nothing here has been measured.",
    "shellJsGzipKb": 180,
    "graphChunkGzipKb": 350,
    "lcpMs": 2500,
    "inpMs": 200,
    "cls": 0.1,
    "frameMs": 16.6,
    "maxNodesFromApi": 300,
    "maxEdgesFromApi": 1000
  }
}
