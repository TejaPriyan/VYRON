{
  "name": "VYRON: The Living Map of Technology",
  "short_name": "VYRON",
  "description": "Provenance-first interactive technology map, live GitHub repository reader, PyPI/npm dependency explorer, and side-by-side comparison tool.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0a0e14",
