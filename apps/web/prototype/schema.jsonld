      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "keywords": "technology map, dependency graph, GitHub repository analyzer, PyPI dependencies, npm dependencies, release history, software provenance",
      "knowsAbout": [
        "Software engineering ecosystems",
        "GitHub public repositories",
        "PyPI Python package dependencies",
        "npm JavaScript package dependencies",
        "Software dependency graphs",
        "Data provenance"
      ],
      "description": "Open-source development prototype mapping technology ecosystems with explicit provenance, live GitHub repository readings, live PyPI/npm dependency trees, release histories, and side-by-side package and repository comparison.",
      "featureList": [
        "Interactive SVG technology map with cluster detection and accessible text outline",
        "Shortest-path finder between technologies using the live graph API",
        "Historical year timeline strip with Play and Pause playback",
        "Live public GitHub repository analysis with contributors, latest release, and 52-week commit activity",
        "Live PyPI and npm interactive dependency graph and release date timeline",
        "Side-by-side comparison of two packages or two GitHub repositories with overlap diff",
        "Client-side JSON evidence pack export with exact source URLs and timestamps",
        "Markdown content negotiation (Accept: text/markdown) and llms.txt discovery for AI agents"
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://vyronmap.vercel.app/#map",
