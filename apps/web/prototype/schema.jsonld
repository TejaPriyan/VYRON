      "url": "https://vyronmap.vercel.app/",
      "name": "VYRON: The Living Map of Technology",
      "alternateName": "VYRON",
      "description": "An open-source, provenance-first technology atlas for exploring technology relationships, shortest paths, timelines, live GitHub repositories, live PyPI and npm dependency graphs, release histories, and side-by-side comparisons.",
