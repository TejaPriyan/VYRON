    {
      "@type": "WebPage",
      "@id": "https://vyronmap.vercel.app/privacy#page",
      "url": "https://vyronmap.vercel.app/privacy",
      "name": "VYRON Privacy & Data Handling",
      "isPartOf": {
        "@id": "https://vyronmap.vercel.app/#website"
      },
      "description": "How VYRON protects privacy with zero browser storage, zero tracking cookies, server-side-only upstream reads, and strict CSP."
    },
    {
      "@type": "FAQPage",
      "@id": "https://vyronmap.vercel.app/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is VYRON?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "VYRON is an open-source, provenance-first technology atlas prototype. It combines an interactive technology graph with live, unstored readings of public GitHub repositories and PyPI/npm package dependency graphs and release histories."
          }
        },
        {
          "@type": "Question",
          "name": "Where does VYRON get repository and package data?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Live readings come directly from the GitHub REST API, PyPI JSON API, and npm registry API on request. Every response displays exact source URLs, cache freshness, and read timestamps; the map page uses clearly labelled development seed data."
          }
        },
        {
          "@type": "Question",
          "name": "Does VYRON store personal data or tokens in the browser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. VYRON uses no browser storage (no localStorage, sessionStorage, or tracking cookies), enforces a strict Content Security Policy, and performs all external API requests server-side."
          }
        },
        {
          "@type": "Question",
          "name": "How can AI agents and developers query VYRON programmatically?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "VYRON exposes a same-origin JSON HTTP API under /api/v1/* (including live GitHub repository analysis and PyPI/npm dependency and release endpoints), serves /llms.txt and /llms-full.txt discovery manifests, and supports Accept: text/markdown content negotiation on all HTML pages."
          }
        }
      ]
    }
  ]
}
