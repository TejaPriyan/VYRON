{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm i --no-audit --no-fund --prefix /tmp/vt typescript@6.0.3 && /tmp/vt/node_modules/.bin/tsc -p apps/web/prototype/tsconfig.json",
  "outputDirectory": "apps/web/prototype/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{apps/api/src/**,apps/web/prototype/**,apps/web/src/styles/tokens.css}"
    }
  },
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
